{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/claude-hardhat.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/claude-pulse.ps1\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/claude-session-start.ps1\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/claude-session-end.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/claude-clock-out.ps1\""
          }
        ]
      }
    ]
  }
}
